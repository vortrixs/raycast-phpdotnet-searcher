{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "php-documentation",
  "title": "PHP Documentation",
  "description": "Search for PHP documentation and open the relevant page in your browser.",
  "icon": "extension_icon.png",
  "license": "MIT",
  "commands": [
    {
      "name": "search-php-net",
      "title": "Search php.net",
      "description": "Search for documentation on php.net",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.0",
    "@raycast/utils": "^2.2.1",
    "fuse.js": "^7.1.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "build": "ray build",
    "publish": "npx @raycast/api@latest publish",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1"
  },
  "author": "vortrixs",
  "platforms": [
    "Windows",
    "macOS"
  ],
  "categories": [
    "Documentation",
    "Developer Tools"
  ],
  "preferences": [
    {
      "name": "language",
      "type": "dropdown",
      "title": "Language",
      "description": "Select the language to use when searching for PHP documentation.",
      "data": [
        {
          "title": "English",
          "value": "en"
        },
        {
          "title": "German",
          "value": "de"
        },
        {
          "title": "Spanish",
          "value": "es"
        },
        {
          "title": "French",
          "value": "fr"
        },
        {
          "title": "Italian",
          "value": "it"
        },
        {
          "title": "Japanese",
          "value": "ja"
        },
        {
          "title": "Brazilian Portuguese",
          "value": "pt_BR"
        },
        {
          "title": "Russian",
          "value": "ru"
        },
        {
          "title": "Turkish",
          "value": "tr"
        },
        {
          "title": "Ukrainian",
          "value": "uk"
        },
        {
          "title": "Chinese (Simplified)",
          "value": "zh"
        }
      ],
      "default": "en"
    }
  ]
}
